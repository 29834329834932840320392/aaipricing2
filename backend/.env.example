# Database
DATABASE_URL=postgresql://ancira_user:your_password_here@localhost:5432/ancira_intel
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Security
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption (for storing OpenAI API key in DB)
ENCRYPTION_KEY=generate-this-with-cryptography.fernet.generate_key()

# Application
APP_NAME="Ancira Competitive Intelligence Dashboard"
APP_VERSION=1.0.0
DEBUG=False
ENVIRONMENT=production

# CORS (adjust for your domain)
CORS_ORIGINS=["https://intel.anciragroup.com","http://localhost:3000"]

# Scraping
# TODO: Remove 10-VDP limit before production
SCRAPE_VDP_LIMIT=10
SCRAPE_TIMEOUT_SECONDS=30
PLAYWRIGHT_HEADLESS=True

# OpenAI (default - can be overridden in admin panel)
DEFAULT_OPENAI_MODEL=gpt-5.4-mini-2026-03-17

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/ancira-intel/app.log

# Admin User (created on first startup if no users exist)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@anciragroup.com
INITIAL_ADMIN_PASSWORD=ChangeMe123!
